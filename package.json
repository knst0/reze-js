{
  "name": "@rezejs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node scripts/bench/size.mts",
    "bench:size:docs": "pnpm build && pnpm --filter @rezejs/docs exec vp build && node scripts/bench/docs-size.mjs",
    "build": "turbo build --filter=./packages/*",
    "fmt": "vp fmt",
    "lint": "vp lint --type-aware --type-check",
    "test": "vp test run && playwright test",
    "test:fast": "vp test run && playwright test --project=chromium-*",
    "test:rust": "cargo test --workspace",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.63.0",
    "@rezejs/compiler": "workspace:*",
    "@types/node": "^26.6.2",
    "playwright": "1.63.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
