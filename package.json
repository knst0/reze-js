{
  "name": "@rezejs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:codspeed": "pnpm --workspace-concurrency=1 --filter \"./packages/*\" --if-present bench:codspeed",
    "bench:rendering": "node benches/rendering/run.mjs",
    "bench:router": "node benches/router/run.mjs",
    "bench:scaling": "node benches/component-scaling/run.mjs",
    "bench:signals": "pnpm --filter @rezejs/signals bench",
    "bench:size": "node benches/bundle-size/log.mjs",
    "build": "turbo build --filter=./packages/*",
    "fmt": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "test": "cross-env VITEST_ENV=chromium vitest run",
    "test:browsers": "cross-env VITEST_ENV=all-browsers vitest run",
    "test:fast": "vitest run",
    "test:firefox": "cross-env VITEST_ENV=firefox vitest run",
    "test:rust": "cargo test --workspace",
    "test:watch": "cross-env VITEST_ENV=chromium vitest",
    "test:webkit": "cross-env VITEST_ENV=webkit vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "5.0.1",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "1.63.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
