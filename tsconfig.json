{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "reze-js",
    "paths": {
      "reze-js": ["./packages/reze-js/src/index.ts"],
      "reze-js/jsx-runtime": ["./packages/reze-js/src/jsx-runtime.ts"],
      "reze-js/jsx-dev-runtime": ["./packages/reze-js/src/jsx-dev-runtime.ts"],
      "reze-js/internal/reactivity": ["./packages/reze-js/src/internal/reactivity.ts"],
      "reze-js/internal/runtime": ["./packages/reze-js/src/internal/runtime.ts"],
      "reze-js/internal/async": ["./packages/reze-js/src/internal/async.ts"],
      "reze-js/internal/html": ["./packages/reze-js/src/internal/html.ts"],
      "reze-js/internal/client": ["./packages/reze-js/src/internal/client.ts"],
      "reze-js/server": ["./packages/reze-js/src/server/node.ts"],
      "@rezejs/dom": ["./packages/dom/src/index.ts"],
      "@rezejs/dom/jsx-runtime": ["./packages/dom/src/jsx-runtime.ts"],
      "@rezejs/dom/jsx-dev-runtime": ["./packages/dom/src/jsx-dev-runtime.ts"],
      "@rezejs/router": ["./packages/router/src/index.ts"],
      "@rezejs/router/fs": ["./packages/router/src/fs/index.ts"],
      "@rezejs/query": ["./packages/query/src/index.ts"],
      "@rezejs/signals": ["./packages/signals/src/index.ts"],
      "@rezejs/signals/render": ["./packages/signals/src/render.ts"],
      "@rezejs/signals/profile": ["./packages/signals/src/profile.ts"],
      "@rezejs/testing-library": ["./packages/testing-library/src/index.ts"]
    },
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "exclude": ["**/node_modules", "examples"]
}
