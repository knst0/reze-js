{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "reze-js",
    "paths": {
      "reze-js": ["./packages/reze-js/src/index.ts"],
      "reze-js/jsx-runtime": ["./packages/reze-js/src/jsx-runtime.ts"],
      "reze-js/jsx-dev-runtime": ["./packages/reze-js/src/jsx-dev-runtime.ts"],
      "reze-js/runtime/server": ["./packages/reze-js/src/runtime/server.ts"],
      "reze-js/server": ["./packages/reze-js/src/server.ts"],
      "reze-js/types": ["./packages/reze-js/src/types.ts"]
    },
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "exclude": ["**/node_modules", "**/dist", "examples", "docs", "tests/apps/*/src/routes.gen.d.ts", "tests/apps/shop"]
}
