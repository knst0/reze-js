import { action } from "reze-js";
export const bump = action((_a$, state) => { try {
  state.n += 1;
} finally { _a$.end(); } });
export const save = action(async (_a$, todo) => { try {
  api.save(todo).then((saved) => {
    todo.at = saved.at;
  });
  setTimeout(() => { delete todo.draft; });
  const later = async () => { todo.count++; };
  _a$.resume(await _a$.suspend(later()));
} finally { _a$.end(); } });
