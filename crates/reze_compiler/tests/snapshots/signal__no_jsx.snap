expression: "import { $signal } from \"reze-js\";\nlet count = $signal(0);\nexport const inc = () => { count += 1; };\nexport const read = () => count;"
---
import { signal } from "reze-js";
const [count, setCount] = signal(0);
export const inc = () => { setCount(count() + 1); };
export const read = () => count();
