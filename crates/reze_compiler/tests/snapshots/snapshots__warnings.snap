import { template as _$template, append as _$append, list as _$list } from "reze-js";
const [n, setN] = signal(0); setN(1);
function Greeting({ name = fallback() }) {
  {
  var _el$ = _$template("<p key=k clas=x title=y>");
  _$append(_el$, name);
  _$append(_el$, _$list(() => [1, 2], (i) => i));
  return _el$;
}
