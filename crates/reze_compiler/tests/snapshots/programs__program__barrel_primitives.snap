import * as R from "reze-js";

import { s, store } from "./lib";
import * as lib from "./lib";
import { signal as _$signal, ssr as _$ssr, ssrHydrationKey as _$ssrHydrationKey, ssrChild as _$ssrChild } from "reze-js";
const _tmpl$ = ["<h1 title=\"x\"", ">Reze 2 ", "</h1>"];

const title = "Reze";
const count = 2;
const label = "x";
const [todo$done, setTodo$done] = _$signal(false);

export const App = () => (
  _$ssr(_tmpl$, _$ssrHydrationKey(), _$ssrChild(todo$done() ? "yes" : "no"))
);

