import * as R from "reze-js";

import { s, store } from "./lib";
import * as lib from "./lib";
import { signal as _$signal, template as _$template, untrack as _$untrack, bind as _$bind, delegateEvents as _$delegateEvents } from "reze-js";
const _tmpl$ = /*#__PURE__*/ _$template("<h1 title=\"x\">Reze 2 </h1>");

const title = "Reze";
const count = 2;
const label = "x";
const [todo$done, setTodo$done] = _$signal(false);

export const App = () => (
  (() => {
  var _el$ = _tmpl$(),
    _el$2 = _el$.firstChild;
  _el$.$$click = () =>
      void _$untrack(() => {
        setTodo$done(() => !todo$done());
      });
  _$bind(() => _el$2.data = "Reze 2 " + (todo$done() ? "yes" : "no"));
  return _el$;
})()
);

_$delegateEvents(["click"]);

