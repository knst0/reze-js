import { s, store } from "./lib";
import * as lib from "./lib";
import * as R from "reze-js";
import { signal as _$signal, template as _$template, untrack as _$untrack, insert as _$insert, delegateEvents as _$delegateEvents } from "reze-js";
const _tmpl$ = /*#__PURE__*/ _$template("<h1 title=\"x\">Reze 2 </h1>");

const title = "Reze";
const count = 2;
const label = "x";
const [todo$done, setTodo$done] = _$signal(false);

export const App = () => (
  (() => {
  var _el$ = _tmpl$();
  _el$.$$click = () => void _$untrack(() => { setTodo$done(() => !todo$done()); });
  _$insert(_el$, () => todo$done() ? "yes" : "no", null);
  return _el$;
})()
);

_$delegateEvents(["click"]);

