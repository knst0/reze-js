import { createComponent as _$createComponent } from "reze-js";
type Props = { id: number; label: string; as: any; ref?: (el: Element) => void };
export function Row(_props$: Props = { id: 0, label: "", as: "li" }) {
  const data: typeof _props$.id = _props$.id;
  const row = { id: _props$.id, label: _props$.label };
  return _$createComponent(_props$.as, { get ref() { return _props$.ref; }, onClick: () => select(row, data), get children() { return _props$.label; } });
}
// info
[PROPS_REWRITTEN] `Row` destructures its props: the pattern became one props object and every destructured name a read of it at its use, so each read stays reactive.
