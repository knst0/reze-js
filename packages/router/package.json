{
  "name": "@rezejs/router",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/reze-js.git",
    "directory": "packages/router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./internal/swap": {
      "types": "./dist/internal/swap.d.ts",
      "import": "./dist/internal/swap.js"
    },
    "./internal/server": {
      "types": "./dist/internal/server.d.ts",
      "import": "./dist/internal/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:codspeed": "node --import ../../benches/kit/production-env.mjs benches/codspeed.ts",
    "build": "tsdown",
    "test": "vitest run && vitest run --config vitest.node.config.mts"
  },
  "dependencies": {
    "@rezejs/dom": "workspace:^",
    "@rezejs/signals": "workspace:^",
    "reze-js": "workspace:^"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "^5.7.1",
    "@rezejs/compiler": "workspace:*",
    "@rezejs/testing-library": "workspace:*",
    "tinybench": "^6.2.0",
    "vite": "^8.3.0"
  }
}
