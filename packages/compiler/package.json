{
  "name": "@rezejs/compiler",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/reze-js.git",
    "directory": "packages/compiler"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "skills"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "napi build --platform --release --esm --manifest-path ../../crates/reze_compiler_napi/Cargo.toml --output-dir .",
    "build:debug": "napi build --platform --esm --manifest-path ../../crates/reze_compiler_napi/Cargo.toml --output-dir ."
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  },
  "napi": {
    "binaryName": "reze-compiler"
  }
}
