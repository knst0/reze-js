{
  "name": "@rezejs/signals",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/reze-js.git",
    "directory": "packages/signals"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --run",
    "bench:codspeed": "node --import ../../benches/kit/production-env.mjs benches/codspeed.ts",
    "bench:update": "REZE_BENCH_UPDATE=1 vitest bench --run",
    "build": "tsdown",
    "test": "vitest run && vitest run --config vitest.node.config.mts"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "^5.7.1",
    "@rezejs/testing-library": "workspace:*",
    "reactive-framework-test-suite": "0.0.2",
    "rolldown": "^1.2.11",
    "tinybench": "^6.2.0"
  }
}
