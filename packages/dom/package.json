{
  "name": "@rezejs/dom",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/reze-js.git",
    "directory": "packages/dom"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./internal/html": {
      "types": "./dist/internal/html.d.ts",
      "import": "./dist/internal/html.js"
    },
    "./internal/hydrate": {
      "types": "./dist/internal/hydrate.d.ts",
      "import": "./dist/internal/hydrate.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:codspeed": "node --import ../../benches/kit/production-env.mjs benches/codspeed.ts",
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@rezejs/signals": "workspace:^",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "^5.7.1",
    "@rezejs/compiler": "workspace:*",
    "@rezejs/testing-library": "workspace:*",
    "happy-dom": "^20.0.0",
    "tinybench": "^6.2.0"
  }
}
